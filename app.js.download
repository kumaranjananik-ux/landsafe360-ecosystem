          <div>Current Occupancy: <strong>${s.occupancy}</strong></div>
          <div>Distance: <strong>${s.distance}</strong></div>
        </div>
        <div style="font-size:0.76rem; color:var(--text-muted);">
          <strong>Amenities:</strong> ${s.amenities.join(' • ')}
        </div>
      </div>
    `).join('');
