// Global Map & Chart Handles
let leafletMapInstance = null;
let mapPolygons = [];
let mapMarkers = [];
let mapRouteLines = [];
let liveTelemetryChartInstance = null;
let showRoutesOnMap = true;

// --- 2. AI / ML RISK ESTIMATION & EXPLAINABLE AI (XAI) ---
function calculateLandslideRisk(rain, moisture, slope, tilt, soilType = 1, landCover = 1, histIdx = 0.6) {
  // Soil Cohesion & Vegetation Multipliers
  const soilWeights = [0.8, 1.35, 1.0, 0.4]; // 0: Sandy, 1: Clay, 2: Loam, 3: Bedrock
  const vegWeights = [0.5, 1.4, 1.0, 1.25];  // 0: Forest, 1: Barren, 2: Agri, 3: Urban

  const sCoeff = soilWeights[soilType] !== undefined ? soilWeights[soilType] : 1.0;
  const vCoeff = vegWeights[landCover] !== undefined ? vegWeights[landCover] : 1.0;

  // Stresses normalized to geotechnical failure thresholds
  const cRain = Math.min(rain / 200.0, 1.2) * 0.32;
  const cMoist = Math.min(moisture / 90.0, 1.1) * 0.26;
  const cSlope = Math.min(slope / 50.0, 1.2) * 0.22;
  const cTilt = Math.min(tilt / 20.0, 1.5) * 0.20;

  const totalStress = Math.max(cRain + cMoist + cSlope + cTilt, 0.001);
  const baseScore = (cRain + cMoist + cSlope + cTilt) * sCoeff * vCoeff + (histIdx * 0.08);
  const riskScore = Math.min(Math.max(parseFloat((baseScore * 78.0).toFixed(1)), 3.0), 99.4);

  let riskLevel = "LOW";
  let color = "#10b981";
  let actionText = "Routine automated sensor telemetry monitoring. Slope stability is nominal.";

  if (riskScore >= 70.0) {
    riskLevel = "HIGH";
    color = "#ef4444";
    actionText = "IMMEDIATE EVACUATION of downslope zones via Route B. Close highway KM 12-18. Mobilize SDRF teams.";
  } else if (riskScore >= 40.0) {
    riskLevel = "MEDIUM";
    color = "#f59e0b";
    actionText = "Issue Advisory Notice. Restrict heavy hillside transit. Standby quick response teams.";
  }

  // Explainability Stress Breakdown (XAI)
  const xaiFactors = [
    {
      name: "Rainfall Intensity & Infiltration",
      value: `${rain.toFixed(1)} mm`,
      percent: Math.round((cRain / totalStress) * 100),
      severity: rain > 120 ? 'CRITICAL' : (rain > 50 ? 'MODERATE' : 'NORMAL'),
      desc: "High precipitation increases pore water pressure and lubricates subsurface shear slip planes."
    },
    {
      name: "Soil Pore Saturation",
      value: `${moisture.toFixed(1)}%`,
      percent: Math.round((cMoist / totalStress) * 100),
      severity: moisture > 75 ? 'CRITICAL' : (moisture > 55 ? 'MODERATE' : 'NORMAL'),
      desc: "Saturation causes loss of cohesive shear strength and liquefaction in unstable overburden."
    },
    {
      name: "Terrain Steepness & Angle",
      value: `${slope.toFixed(1)}°`,
      percent: Math.round((cSlope / totalStress) * 100),
      severity: slope > 40 ? 'CRITICAL' : (slope > 25 ? 'MODERATE' : 'NORMAL'),
      desc: "Gravitational driving stress exceeds critical holding resistance on steep slopes."
    },
    {
      name: "Active Inclinometer Creep / Tilt",
      value: `${tilt.toFixed(1)} mm/d`,
      percent: Math.round((cTilt / totalStress) * 100),
      severity: tilt > 8.0 ? 'CRITICAL' : (tilt > 2.0 ? 'MODERATE' : 'NORMAL'),
      desc: "Displacement velocity acceleration indicates progressive shear failure."
    }
  ];

  xaiFactors.sort((a, b) => b.percent - a.percent);

  return {
    score: riskScore,
    level: riskLevel,
    color: color,
    action: actionText,
    factors: xaiFactors
  };
}

// --- 3. PAGE NAVIGATION ROUTER ---
function navigateTo(pageId) {
  AppState.activePage = pageId;

  // Update Navigation tab buttons
  document.querySelectorAll('.nav-btn').forEach(btn => {
    btn.classList.toggle('active', btn.getAttribute('data-page') === pageId);
  });

  // Update Page Views
  document.querySelectorAll('.page-view').forEach(view => {
    view.classList.toggle('active', view.id === `page-${pageId}`);
  });

  window.scrollTo({ top: 0, behavior: 'smooth' });

  // Page Specific Inits / Refreshes
  if (pageId === 'dashboard') {
    renderDashboard();
  } else if (pageId === 'gis') {
    setTimeout(() => {
      if (!leafletMapInstance) {
        initLeafletMap();
      } else {
        leafletMapInstance.invalidateSize();
      }
    }, 200);
  } else if (pageId === 'sensors') {
    setTimeout(() => {
      if (!liveTelemetryChartInstance) {
        initTelemetryChart();
      }
    }, 200);
  } else if (pageId === 'ai') {
    updateAiSandbox();
  } else if (pageId === 'resident') {
    renderResidentPortal();
  } else if (pageId === 'officer') {
    renderOfficerPortal();
  } else if (pageId === 'tourist') {
    updateTouristAdvisory();
  } else if (pageId === 'alerts') {
    renderAlertsPage();
  } else if (pageId === 'evacuation') {
    renderSheltersList();
  } else if (pageId === 'citizen') {
    renderCitizenFeed();
  }
}

// --- OPERATIONS DASHBOARD RENDERING ---
function renderDashboard() {
  const currentSt = AppState.stations[0];
  const aiResult = calculateLandslideRisk(
    currentSt.rainfall,
    currentSt.soil_moisture,
    currentSt.slope,
    currentSt.ground_movement,
    currentSt.soil_type_code,
    currentSt.land_cover_code
  );

  const scoreEl = document.getElementById('dashRiskScore');
  const pillEl = document.getElementById('dashRiskPill');
  const progressCircle = document.getElementById('dashRiskProgress');
  const descEl = document.getElementById('dashStatusDescription');

  if (scoreEl) scoreEl.innerText = `${aiResult.score}%`;
  if (pillEl) {
    pillEl.innerText = `${aiResult.level} RISK`;
    pillEl.className = `risk-status-pill ${aiResult.level.toLowerCase()}`;
  }
  if (descEl) {
    descEl.innerText = aiResult.level === 'HIGH' 
      ? 'Critical pore pressure saturation and ongoing ground creep detected. High probability of mass slope failure.' 
      : (aiResult.level === 'MEDIUM' ? 'Moderate slope stress from continuous rainfall. Heightened landslide susceptibility.' : 'Slope stability sensors indicate normal baseline conditions. No imminent risk.');
  }

  if (progressCircle) {
    const offset = 440 - (440 * (aiResult.score / 100));
    progressCircle.style.strokeDashoffset = offset;
    progressCircle.style.stroke = aiResult.color;
  }

  const rainVal = document.getElementById('dashRainVal');
  const soilVal = document.getElementById('dashSoilVal');
  const tiltVal = document.getElementById('dashTiltVal');
  const tempVal = document.getElementById('dashTempHumVal');

  if (rainVal) rainVal.innerText = `${currentSt.rainfall.toFixed(1)} mm`;
  if (soilVal) soilVal.innerText = `${currentSt.soil_moisture.toFixed(1)}%`;
  if (tiltVal) tiltVal.innerText = `${currentSt.ground_movement.toFixed(1)} mm/d`;
  if (tempVal) tempVal.innerText = `${currentSt.temp.toFixed(1)}°C / ${currentSt.humidity}%`;

  const xaiContainer = document.getElementById('dashXaiList');
  if (xaiContainer) {
    xaiContainer.innerHTML = aiResult.factors.map(f => `
      <div class="xai-factor-item">
        <div class="xai-factor-header">
          <span style="color:#fff;">${f.name} (${f.value})</span>
          <span style="color:${f.severity === 'CRITICAL' ? 'var(--risk-high)' : 'var(--accent-cyan)'}; font-weight:700;">${f.percent}% impact</span>
        </div>
        <div class="xai-progress-bg">
          <div class="xai-progress-fill" style="width: ${f.percent}%; background: ${f.severity === 'CRITICAL' ? 'var(--risk-high)' : 'var(--accent-cyan)'};"></div>
        </div>
      </div>
    `).join('');
  }

  const tableBody = document.getElementById('dashboardSectorTableBody');
  if (tableBody) {
    tableBody.innerHTML = AppState.stations.map(st => {
      const pred = calculateLandslideRisk(st.rainfall, st.soil_moisture, st.slope, st.ground_movement, st.soil_type_code, st.land_cover_code);
      return `
        <tr>
          <td><strong>${st.name}</strong><br><span style="font-size:0.72rem; color:var(--text-dim);">${st.region}</span></td>
          <td>${st.slope}°</td>
          <td>${st.rainfall.toFixed(1)} mm</td>
          <td>${st.soil_moisture.toFixed(1)}%</td>
          <td>${st.ground_movement.toFixed(1)} mm/d</td>
          <td><strong style="color:${pred.color};">${pred.score}%</strong></td>
          <td><span class="risk-status-pill ${pred.level.toLowerCase()}" style="font-size:0.68rem; padding:2px 8px;">${pred.level}</span></td>
          <td><button class="btn btn-outline" style="padding:2px 8px; font-size:0.72rem;" onclick="navigateTo('gis')">Map</button></td>
        </tr>
      `;
    }).join('');
  }

  initOrUpdateTrendChart();
}

let riskTrendChartInstance = null;
function initOrUpdateTrendChart() {
  const ctx = document.getElementById('riskTrendChart');
  if (!ctx) return;

  const labels = ['00:00', '03:00', '06:00', '09:00', '12:00', '15:00', '18:00', 'Now'];
  let riskData = [15, 22, 38, 45, 62, 78, 88, AppState.stations[0].risk_score];
  let rainData = [5, 12, 28, 42, 75, 110, 130, AppState.stations[0].rainfall];

  if (AppState.activeScenario === 'normal') {
    riskData = [12, 14, 15, 16, 18, 17, 19, 18];
    rainData = [2, 3, 4, 8, 10, 12, 14, 15];
  } else if (AppState.activeScenario === 'rain') {
    riskData = [15, 18, 26, 34, 42, 49, 52, 56];
    rainData = [5, 10, 18, 28, 45, 55, 65, 72];
  }

  if (riskTrendChartInstance) {
    riskTrendChartInstance.data.datasets[0].data = riskData;
    riskTrendChartInstance.data.datasets[1].data = rainData;
    riskTrendChartInstance.update();
  } else {
    riskTrendChartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Landslide Risk Score (%)',
            data: riskData,
            borderColor: '#ef4444',
            backgroundColor: 'rgba(239, 68, 68, 0.15)',
            borderWidth: 3,
            fill: true,
            tension: 0.35
          },
          {
            label: 'Cumulative Rainfall (mm)',
            data: rainData,
            borderColor: '#38bdf8',
            backgroundColor: 'transparent',
            borderWidth: 2,
            borderDash: [5, 5],
            tension: 0.3
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { labels: { color: '#94a3b8', font: { family: 'Inter', size: 11 } } }
        },
        scales: {
          x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#64748b' } },
          y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#64748b' }, min: 0, max: 100 }
        }
      }
    });
  }
}

function renderAlertsPage() {
  const currentSt = AppState.stations[0];
  const pred = calculateLandslideRisk(currentSt.rainfall, currentSt.soil_moisture, currentSt.slope, currentSt.ground_movement);

  const headlineEl = document.getElementById('alertHeadline');
  const scoreText = document.getElementById('alertRiskScoreText');
  const factorsList = document.getElementById('alertFactorsList');

  if (headlineEl) headlineEl.innerText = `⚠️ ${pred.level} LANDSLIDE RISK – ${currentSt.name}`;
  if (scoreText) scoreText.innerText = `${pred.score}% (${pred.level})`;

  if (factorsList) {
    factorsList.innerHTML = pred.factors.map(f => `<li>${f.name}: <strong>${f.value}</strong> (${f.percent}% impact)</li>`).join('');
  }
}

// --- 4. HACKATHON DEMO SCENARIOS ---
function triggerScenario(scenario) {
  AppState.activeScenario = scenario;

  document.querySelectorAll('.btn-scenario').forEach(btn => btn.classList.remove('active'));
  if (scenario === 'normal') document.getElementById('btnScenarioNormal')?.classList.add('active');
  if (scenario === 'rain') document.getElementById('btnScenarioRain')?.classList.add('active');
  if (scenario === 'critical') document.getElementById('btnScenarioCritical')?.classList.add('active');

  const st = AppState.stations[0]; // Pine Crest (Sector A)

  if (scenario === 'normal') {
    st.rainfall = 15.0;
    st.soil_moisture = 32.0;
    st.ground_movement = 0.2;
    st.risk_score = 18.0;
    st.risk_level = "LOW";
    st.risk_trend = "STABLE";
    st.trend_label = "→ Stable (18.0%)";
    st.color = "#10b981";
    
    // Safety accountability in normal mode
    AppState.peopleAtRisk.zoneATotal = 0;
    AppState.peopleAtRisk.safeConfirmed = 0;
    AppState.peopleAtRisk.movingInTransit = 0;
    AppState.peopleAtRisk.unaccounted = 0;

    dismissEmergencyBanner();
  } else if (scenario === 'rain') {
    st.rainfall = 72.0;
    st.soil_moisture = 62.0;
    st.ground_movement = 2.4;
    st.risk_score = 56.4;
    st.risk_level = "MEDIUM";
    st.risk_trend = "INCREASING";
    st.trend_label = "↗ Increasing (35% ➔ 56.4%)";
    st.color = "#f59e0b";

    AppState.peopleAtRisk.zoneATotal = 35;
    AppState.peopleAtRisk.safeConfirmed = 20;
    AppState.peopleAtRisk.movingInTransit = 12;
    AppState.peopleAtRisk.unaccounted = 3;

    showEmergencyBanner("⚠️ HEIGHTENED LANDSLIDE RISK (MEDIUM): Pine Crest Ridge – Risk 56.4% | Soil Saturation 62%. Restrict non-essential hillside transit.");
  } else if (scenario === 'critical') {
    st.rainfall = 168.0;
    st.soil_moisture = 92.5;
    st.ground_movement = 16.2;
    st.risk_score = 92.4;
    st.risk_level = "HIGH";
    st.risk_trend = "RAPIDLY_INCREASING";
    st.trend_label = "↗ RAPIDLY INCREASING (42% ➔ 92.4%)";
    st.color = "#ef4444";

    AppState.peopleAtRisk.zoneATotal = 86;
    AppState.peopleAtRisk.safeConfirmed = 63;
    AppState.peopleAtRisk.movingInTransit = 17;
    AppState.peopleAtRisk.unaccounted = 6;

    showEmergencyBanner("🚨 CRITICAL EARLY WARNING: RAPIDLY INCREASING LANDSLIDE RISK DETECTED at Pine Crest Ridge (92.4%). 86 People Potentially Affected. Immediate evacuation via Route B.");
  }

  // Refresh all dependent views
  renderOverviewKpis();
  renderResidentPortal();
  renderOfficerPortal();
  renderCitizenFeed();
  renderSheltersList();
  updateAiSandbox();

  if (leafletMapInstance) {
    updateLeafletMapLayers();
  }
}

function showEmergencyBanner(text) {
  const banner = document.getElementById('globalEmergencyBanner');
  const detail = document.getElementById('bannerDetailText');
  if (banner && detail) {
    detail.textContent = text;
    banner.classList.add('show');
  }
}

function dismissEmergencyBanner() {
  const banner = document.getElementById('globalEmergencyBanner');
  if (banner) banner.classList.remove('show');
}

function resetDemoSystem() {
  triggerScenario('critical');
  alert("Demo system reset to initial state with High Risk evaluation scenario.");
}

// --- 5. RENDER FUNCTIONS FOR THE 3 PORTALS ---

// A. Overview Page KPIs
function renderOverviewKpis() {
  const st = AppState.stations[0];
  const homeHighCount = document.getElementById('homeHighRiskCount');
  if (homeHighCount) {
    homeHighCount.textContent = st.risk_level === 'HIGH' ? '1 Critical' : (st.risk_level === 'MEDIUM' ? '1 Advisory' : '0 None');
    homeHighCount.style.color = st.color;
  }
  const homePeople = document.getElementById('homePeopleRiskCount');
  if (homePeople) {
    homePeople.textContent = `${AppState.peopleAtRisk.zoneATotal} People`;
  }
  const homeSafe = document.getElementById('homeConfirmedSafeCount');
  if (homeSafe) {
    homeSafe.textContent = `${AppState.peopleAtRisk.safeConfirmed} / ${AppState.peopleAtRisk.zoneATotal}`;
  }
}

// B. Resident Portal
function renderResidentPortal() {
  const st = AppState.stations[0];
  const aiResult = calculateLandslideRisk(st.rainfall, st.soil_moisture, st.slope, st.ground_movement, st.soil_type_code, st.land_cover_code);

  // Risk Score & Badge
  const scoreElem = document.getElementById('residentRiskScore');
  if (scoreElem) scoreElem.textContent = `${aiResult.score}%`;

  const pillElem = document.getElementById('residentRiskPill');
  if (pillElem) {
    pillElem.textContent = `${aiResult.level} RISK (${aiResult.level === 'HIGH' ? 'EVACUATE' : 'MONITOR'})`;
    pillElem.className = `risk-status-pill ${aiResult.level.toLowerCase()}`;
  }

  const trendElem = document.getElementById('residentTrendBadge');
  if (trendElem) {
    trendElem.textContent = st.trend_label;
    trendElem.className = `trend-badge ${st.risk_trend === 'RAPIDLY_INCREASING' ? 'increasing' : (st.risk_trend === 'INCREASING' ? 'increasing' : 'stable')}`;
  }

  // Progress Ring
  const progressCircle = document.getElementById('residentRiskProgress');
  if (progressCircle) {
    const circumference = 2 * Math.PI * 70; // 439.82
    const offset = circumference - (aiResult.score / 100) * circumference;
    progressCircle.style.strokeDasharray = `${circumference}`;
    progressCircle.style.strokeDashoffset = `${offset}`;
    progressCircle.style.stroke = aiResult.color;
  }

  // Explainable AI Cards (Why is this area at risk?)
  const xaiContainer = document.getElementById('residentXaiContainer');
  if (xaiContainer) {
    xaiContainer.innerHTML = aiResult.factors.map(f => `
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius:6px; padding:0.6rem 0.8rem;">
        <div style="display:flex; justify-content:space-between; font-size:0.8rem; margin-bottom:3px;">
          <span style="font-weight:700; color:#fff;">${f.name} (${f.value})</span>
          <span style="font-weight:800; color:${f.severity === 'CRITICAL' ? '#f87171' : (f.severity === 'MODERATE' ? '#fcd34d' : '#6ee7b7')};">${f.percent}% Impact</span>
        </div>
        <div style="background:rgba(0,0,0,0.3); height:6px; border-radius:3px; overflow:hidden; margin:3px 0;">
          <div style="width:${f.percent}%; height:100%; background:${f.severity === 'CRITICAL' ? '#ef4444' : (f.severity === 'MODERATE' ? '#f59e0b' : '#10b981')};"></div>
        </div>
        <div style="font-size:0.72rem; color:var(--text-muted);">${f.desc}</div>
      </div>
    `).join('');
  }

  // Render Resident Bio Card, Privacy Center, and Roster Table
  renderResidentBioCard();
  renderRegisteredResidentsTable();
  renderResidentPrivacyCenter();
}

// C. Officer Portal
function renderOfficerPortal() {
  const p = AppState.peopleAtRisk;

  document.getElementById('officerTotalMonitored').textContent = `${p.totalMonitored} People`;
  document.getElementById('officerHighRiskPop').textContent = `${p.zoneATotal} People`;
  document.getElementById('officerPriority1Count').textContent = `${p.priority1Vulnerable} People`;
  document.getElementById('officerUnconfirmedCount').textContent = `${p.unaccounted} Pending`;

  // Real-Time Accountability Bar
  const total = Math.max(p.zoneATotal, 1);
  const safePct = ((p.safeConfirmed / total) * 100).toFixed(1);
  const movePct = ((p.movingInTransit / total) * 100).toFixed(1);
  const unconfPct = ((p.unaccounted / total) * 100).toFixed(1);

  const safeBar = document.getElementById('accSafeBar');
  const moveBar = document.getElementById('accMovingBar');
  const unconfBar = document.getElementById('accUnconfBar');

  if (safeBar) safeBar.style.width = `${safePct}%`;
  if (moveBar) moveBar.style.width = `${movePct}%`;
  if (unconfBar) unconfBar.style.width = `${unconfPct}%`;

  document.getElementById('officerSafeNumber').textContent = `${p.safeConfirmed} (${safePct}%)`;
  document.getElementById('officerMovingNumber').textContent = `${p.movingInTransit} (${movePct}%)`;
  document.getElementById('officerUnconfNumber').textContent = `${p.unaccounted} (${unconfPct}%)`;

  // Officer Citizen Verification List
  const verList = document.getElementById('officerVerificationList');
  if (verList) {
    verList.innerHTML = AppState.citizenReports.map(r => `
      <div style="background: rgba(255,255,255,0.03); border: 1px solid ${r.verified ? 'rgba(16,185,129,0.3)' : 'rgba(239,68,68,0.4)'}; border-radius:8px; padding:0.85rem;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.4rem;">
          <div>
            <span style="font-size:0.75rem; font-weight:800; color:${r.verified ? '#10b981' : '#f87171'};">${r.verified ? '✓ VERIFIED BY OFFICER' : '⚠️ UNDER REVIEW (ACTION REQUIRED)'}</span>
            <h4 style="color:#fff; font-size:0.95rem; margin-top:2px;">${r.type} – ${r.location}</h4>
          </div>
          <span style="font-size:0.72rem; color:var(--text-dim);">${r.time}</span>
        </div>
        <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.6rem;">"${r.desc}"</p>
        <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
          ${!r.verified ? `
            <button class="btn btn-outline" style="font-size:0.75rem; padding:0.25rem 0.6rem;" onclick="officerVerifyReport('${r.id}', false)">❌ Reject (False Alarm)</button>
            <button class="btn btn-primary" style="font-size:0.75rem; padding:0.25rem 0.6rem;" onclick="officerVerifyReport('${r.id}', true)">✅ Verify & Broadcast Alert</button>
          ` : `
            <span style="font-size:0.75rem; color:#10b981; font-weight:700;">Broadcasted to sirens & mobile SMS</span>
          `}
        </div>
      </div>
    `).join('');
  }

  // Render 26. Privacy & Safety Layer components
  renderOfficerZonePrivacyRoster();
  renderPrivacyAuditLog();

  // Render 27. Real-Time Data Integration Status Panel
  renderRealTimeStatusPanel();
}

// D. Tourist Portal Advisory Update
function updateTouristAdvisory() {
  const select = document.getElementById('touristSectorSelect');
  const sectorId = select ? select.value : 'ST-01';
  const st = AppState.stations.find(s => s.id === sectorId) || AppState.stations[0];

  const title = document.getElementById('touristAdvisoryTitle');
  const desc = document.getElementById('touristAdvisoryDesc');
  const box = document.getElementById('touristAdvisoryBox');
  const pass = document.getElementById('touristPassStatus');

  if (st.risk_level === 'HIGH') {
    box.style.background = 'rgba(239, 68, 68, 0.12)';
    box.style.borderColor = 'rgba(239, 68, 68, 0.4)';
    title.textContent = `⚠️ HIGH RISK AREA: TRAVEL ADVISORY ACTIVE (${st.name})`;
    title.style.color = '#f87171';
    desc.textContent = `${st.name} is currently under extreme landslide threat (Risk Score: ${st.risk_score}%). Rainfall is ${st.rainfall}mm. Travel is strictly advised against. Proceed to safe low-altitude zones.`;
    pass.textContent = 'CLOSED (KM 12–18)';
    pass.style.color = '#ef4444';
  } else if (st.risk_level === 'MEDIUM') {
    box.style.background = 'rgba(245, 158, 11, 0.12)';
    box.style.borderColor = 'rgba(245, 158, 11, 0.4)';
    title.textContent = `🟡 MODERATE RISK ADVISORY (${st.name})`;
    title.style.color = '#fcd34d';
    desc.textContent = `Heightened rain observed in ${st.name} (${st.rainfall}mm). Exercise caution and avoid night travel on steep cliffs.`;
    pass.textContent = 'CAUTION / RESTRICTED';
    pass.style.color = '#f59e0b';
  } else {
    box.style.background = 'rgba(16, 185, 129, 0.12)';
    box.style.borderColor = 'rgba(16, 185, 129, 0.4)';
    title.textContent = `🟢 SAFE TO VISIT (${st.name})`;
    title.style.color = '#6ee7b7';
    desc.textContent = `Slope sensors show stable conditions in ${st.name}. No current rainfall alarms. Standard mountain driving precautions apply.`;
    pass.textContent = 'OPEN / ALL CLEAR';
    pass.style.color = '#10b981';
  }

  // Render Tourist Bio Pass Card and Directory Table
  renderTouristBioCard();
  renderRegisteredTouristsTable();
}

// --- 6. "I AM SAFE" ACCOUNTABILITY ACTION ---
function confirmSafetyAction(portalSource) {
  const p = AppState.peopleAtRisk;

  // Increment safe count if unconfirmed exist
  if (p.unaccounted > 0) {
    p.safeConfirmed += 1;
    p.unaccounted -= 1;
  }

  const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

  if (portalSource === 'resident') {
    const feedback = document.getElementById('residentSafeFeedback');
    const timeElem = document.getElementById('residentSafeTime');
    if (feedback && timeElem) {
      timeElem.textContent = now;
      feedback.style.display = 'block';
    }
  } else if (portalSource === 'tourist') {
    const feedback = document.getElementById('touristSafeFeedback');
    if (feedback) feedback.style.display = 'block';
  }

  // 26.8 "I AM SAFE" Privacy Audit Logging (Aggregated on general dashboard, logged anonymously internally)
  logPrivacyAudit(
    portalSource === 'resident' ? AppState.privacy.currentResidentId : "TR-501",
    `Safety Confirmation (I AM SAFE)`,
    portalSource === 'resident' ? "Relief Shelter #1" : "Valley Sports Stadium Camp",
    "Headcount Aggregation Loop (Zero Live GPS Exposed)",
    "CONFIRMED"
  );

  // Immediately refresh Officer Command and Overview tallies
  renderOfficerPortal();
  renderOverviewKpis();

  // Highlight success
  alert(`✓ "I AM SAFE" Confirmation Received!\n\nYour status has been logged at Central Disaster Shelter #1 at ${now}.\nOfficer Command accountability roster updated in real time.`);
}

// --- 7. HUMAN-IN-THE-LOOP OFFICER VERIFICATION ---
function officerVerifyReport(reportId, isVerified) {
  const rep = AppState.citizenReports.find(r => r.id === reportId);
  if (rep) {
    if (isVerified) {
      rep.verified = true;
      rep.status = "VERIFIED";
      alert(`✅ Citizen Hazard Report ${reportId} has been VERIFIED by Officer.\n\nSimulated automated broadcast dispatched to In-App, SMS, and WhatsApp alerts!`);
    } else {
      rep.status = "RESOLVED";
      alert(`❌ Report ${reportId} marked as FALSE ALARM / Non-hazardous after field review.`);
    }

    logPrivacyAudit(
      AppState.privacy.currentOfficerId,
      isVerified ? `Citizen Hazard Report Verified (${reportId})` : `Report Marked False Alarm (${reportId})`,
      rep.location,
      "Human-in-the-Loop Verification Prior to Public Alert",
      isVerified ? "VERIFIED" : "DISMISSED"
    );

    renderOfficerPortal();
    renderCitizenFeed();
  }
}

// --- 8. RESIDENT & TOURIST BIO REGISTRATION HANDLERS ---
function handleResidentBioSubmit(event) {
  event.preventDefault();
  const name = document.getElementById('resBioName').value;
  const age = parseInt(document.getElementById('resBioAge').value) || 35;
  const gender = document.getElementById('resBioGender').value;
  const blood = document.getElementById('resBioBlood').value;
  const govtId = document.getElementById('resBioId').value;
  const phone = document.getElementById('resBioPhone').value;
  const sector = document.getElementById('resBioSector').value;
  const familyCount = parseInt(document.getElementById('resBioFamilyCount').value) || 1;
  const vulnerability = document.getElementById('resBioVulnerability').value;
  const emergency = document.getElementById('resBioEmergencyContact').value;
  const medical = document.getElementById('resBioMedical').value || "None";

  // 26.1 Privacy Consent check
  const consentAgree = document.getElementById('resConsentAgree');
  const isConsent = consentAgree ? consentAgree.checked : true;
  const anonId = `RS-${Math.floor(Math.random() * 9000 + 1000)}`;

  const newResident = {
    id: `RES-${Math.floor(Math.random() * 900 + 100)}`,
    anonymousId: anonId,
    name: name,
    age: age,
    gender: gender,
    bloodGroup: blood,
    govtId: govtId,
    phone: phone,
    sector: sector,
    familyCount: familyCount,
    vulnerability: vulnerability,
    emergencyContact: emergency,
    medical: medical,
    status: "SAFE_CONFIRMED",
    shelter: "Central Relief Shelter #1",
    privacyConsent: isConsent ? "GRANTED" : "DENIED",
    locationMonitoring: isConsent ? "ENABLED" : "DISABLED"
  };

  AppState.privacy.currentResidentId = anonId;
  AppState.privacy.consentGranted = isConsent;
  AppState.privacy.locationMonitoring = isConsent;

  // Add to residents list
  AppState.residents.unshift(newResident);
  
  // Update People at Risk
  AppState.peopleAtRisk.totalMonitored += familyCount;
  if (vulnerability !== 'None') {
    AppState.peopleAtRisk.priority1Vulnerable += 1;
  }

  // 26.10 Audit Logging
  logPrivacyAudit(
    anonId,
    `Resident Bio Registration (Consent: ${newResident.privacyConsent})`,
    sector,
    "Disaster Roster Enrolment & Triage Classification",
    "VERIFIED"
  );

  renderResidentBioCard(newResident);
  renderRegisteredResidentsTable();
  renderResidentPrivacyCenter();
  renderOfficerPortal();
  renderOverviewKpis();

  if (!isConsent) {
    alert(`⚠️ Note: Privacy Consent was DENIED.\nLocation-based risk monitoring has been DISABLED for your account until consent is granted.\n\nAnonymous ID: ${anonId}`);
  } else {
    alert(`✅ Resident Bio Profile Saved!\n\nAnonymous Resident ID: ${anonId}\nDigital Safety Pass generated for ${name} (${familyCount} family members).\nPrivacy Consent: GRANTED (Location Monitoring Active).`);
  }
}

function renderResidentBioCard(res) {
  const current = res || AppState.residents[0];
  if (!current) return;

  const anonEl = document.getElementById('passResidentAnonId');
  if (anonEl) anonEl.textContent = current.anonymousId || "RS-1042";

  const nameEl = document.getElementById('passResidentName');
  const sectorEl = document.getElementById('passResidentSector');
  const bloodAgeEl = document.getElementById('passResidentBloodAge');
  const familyEl = document.getElementById('passResidentFamily');
  const vulnEl = document.getElementById('passResidentVulnerability');
  const idEl = document.getElementById('passResidentId');
  const emergEl = document.getElementById('passResidentEmergency');

  if (nameEl) nameEl.textContent = current.name;
  if (sectorEl) sectorEl.textContent = current.sector;
  if (bloodAgeEl) bloodAgeEl.textContent = `${current.bloodGroup} | ${current.age} Yrs (${current.gender})`;
  if (familyEl) familyEl.textContent = `${current.familyCount} Members`;
  if (vulnEl) {
    vulnEl.textContent = current.vulnerability;
    vulnEl.className = `priority-pill ${current.vulnerability !== 'None' ? 'priority-p1' : 'priority-p2'}`;
  }
  if (idEl) idEl.textContent = current.govtId;
  if (emergEl) emergEl.textContent = current.emergencyContact;
}

function renderRegisteredResidentsTable() {
  const tbody = document.getElementById('residentRosterTableBody');
  const badge = document.getElementById('residentCountBadge');

  if (badge) badge.textContent = `${AppState.residents.length} Households`;
  if (!tbody) return;

  tbody.innerHTML = AppState.residents.map(r => `
    <tr>
      <td>
        <strong>${r.name}</strong> (${r.age}y, ${r.bloodGroup})<br>
        <span style="font-size:0.72rem; color:var(--text-dim);">${r.govtId}</span>
      </td>
      <td><strong>${r.familyCount}</strong> members</td>
      <td>
        <span class="priority-pill ${r.vulnerability !== 'None' ? 'priority-p1' : 'priority-p2'}">${r.vulnerability}</span>
      </td>
      <td>
        ${r.phone}<br>
        <span style="font-size:0.7rem; color:var(--accent-cyan);">${r.emergencyContact}</span>
      </td>
      <td>
        <span style="font-size:0.75rem; font-weight:700; color:${r.status === 'SAFE_CONFIRMED' ? '#10b981' : '#f59e0b'};">
          ${r.status === 'SAFE_CONFIRMED' ? '🟢 SAFE' : '🟡 IN TRANSIT'}
        </span>
      </td>
    </tr>
  `).join('');
}

function handleTouristBioSubmit(event) {
  event.preventDefault();
  const name = document.getElementById('touristBioName').value;
  const age = parseInt(document.getElementById('touristBioAge').value) || 30;
  const nationality = document.getElementById('touristBioNationality').value;
  const passportId = document.getElementById('touristBioId').value;
  const phone = document.getElementById('touristBioPhone').value;
  const hotel = document.getElementById('touristBioHotel').value;
  const sector = document.getElementById('touristBioSector').value;
  const groupSize = parseInt(document.getElementById('touristBioGroupSize').value) || 1;
  const language = document.getElementById('touristBioLanguage').value;
  const driver = document.getElementById('touristBioDriver').value || "Self Driving";
  const emergency = document.getElementById('touristBioEmergency').value;

  const newTourist = {
    id: `TR-${Math.floor(Math.random() * 900 + 100)}`,
    name: name,
    age: age,
    gender: "Traveler",
    nationality: nationality,
    passportId: passportId,
    phone: phone,
    hotel: hotel,
    sector: sector,
    groupSize: groupSize,
    language: language,
    driver: driver,
    emergencyContact: emergency,
    status: "SAFE_CONFIRMED",
    haven: "Valley Sports Stadium Camp"
  };

  AppState.tourists.unshift(newTourist);
  AppState.peopleAtRisk.priority3Tourists += groupSize;

  renderTouristBioCard(newTourist);
  renderRegisteredTouristsTable();
  renderOfficerPortal();
  renderOverviewKpis();

  alert(`✅ Tourist Travel E-Pass Registered!\n\nWelcome ${name} (Party of ${groupSize}).\nMulti-lingual alerts in ${language} have been enabled for your mobile.`);
}

function renderTouristBioCard(tr) {
  const current = tr || AppState.tourists[0];
  if (!current) return;

  const nameEl = document.getElementById('passTouristName');
  const hotelEl = document.getElementById('passTouristHotel');
  const natAgeEl = document.getElementById('passTouristNatAge');
  const partyEl = document.getElementById('passTouristParty');
  const langEl = document.getElementById('passTouristLang');
  const idEl = document.getElementById('passTouristId');
  const emergEl = document.getElementById('passTouristEmergency');

  if (nameEl) nameEl.textContent = current.name;
  if (hotelEl) hotelEl.textContent = `${current.hotel} • ${current.sector}`;
  if (natAgeEl) natAgeEl.textContent = `${current.nationality} | ${current.age} Yrs`;
  if (partyEl) partyEl.textContent = `${current.groupSize} Persons`;
  if (langEl) langEl.textContent = `${current.language} (SMS Active)`;
  if (idEl) idEl.textContent = current.passportId;
  if (emergEl) emergEl.textContent = current.emergencyContact;
}

function renderRegisteredTouristsTable() {
  const tbody = document.getElementById('touristRosterTableBody');
  const badge = document.getElementById('touristCountBadge');

  if (badge) badge.textContent = `${AppState.tourists.length} Parties`;
