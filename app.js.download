      </td>
      <td><strong>${t.groupSize}</strong> ppl (${t.language})</td>
      <td>
        <span style="font-size:0.75rem; font-weight:700; color:${t.status === 'SAFE_CONFIRMED' ? '#10b981' : '#f59e0b'};">
          ${t.status === 'SAFE_CONFIRMED' ? '🟢 SAFE' : '🟡 IN TRANSIT'}
        </span>
      </td>
    </tr>
  `).join('');
}

function handleResidentHazardSubmit(event) {
  event.preventDefault();
  const type = document.getElementById('resHazardType').value;
  const loc = document.getElementById('resHazardLocation').value;
  const desc = document.getElementById('resHazardDesc').value;

  const newReport = {
    id: `REP-2026-${Math.floor(Math.random() * 900 + 100)}`,
    name: "Ramesh Sharma (Resident)",
    location: loc,
    lat: 30.3180,
    lng: 78.0350,
    type: type,
    severity: "Critical",
    desc: desc,
    photo: "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=600&auto=format&fit=crop&q=80",
    time: "Just now",
    status: "UNDER_REVIEW",
    verified: false
  };

  AppState.citizenReports.unshift(newReport);
  document.getElementById('residentHazardForm').reset();
  alert("✓ Field hazard report submitted successfully!\n\nReport has been forwarded to the Officer Verification Queue for emergency assessment.");
  renderOfficerPortal();
  renderCitizenFeed();
}

function handleCitizenReportSubmit(event) {
  event.preventDefault();
  const name = document.getElementById('repName').value;
  const loc = document.getElementById('repLocation').value;
  const type = document.getElementById('repType').value;
  const severity = document.getElementById('repSeverity').value;
  const desc = document.getElementById('repDesc').value;
  const photo = document.getElementById('repPhotoPreset').value;

  const newReport = {
    id: `REP-2026-${Math.floor(Math.random() * 900 + 100)}`,
    name: name,
    location: loc,
    lat: 30.3180 + (Math.random() - 0.5) * 0.02,
    lng: 78.0350 + (Math.random() - 0.5) * 0.02,
    type: type,
    severity: severity,
    desc: desc,
    photo: photo,
    time: "Just now",
    status: "UNDER_REVIEW",
    verified: false
  };

  AppState.citizenReports.unshift(newReport);
  document.getElementById('citizenReportForm').reset();
  alert("✓ Public hazard observation submitted successfully!");
  renderOfficerPortal();
  renderCitizenFeed();
}

function handleTouristCheckin(event) {
  if (event) event.preventDefault();
  handleTouristBioSubmit(event);
}

function renderCitizenFeed() {
