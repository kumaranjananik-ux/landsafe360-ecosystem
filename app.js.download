        <div style="flex:1;">
          <div style="display:flex; justify-content:space-between;">
            <span style="font-size:0.75rem; font-weight:800; color:${r.severity === 'Critical' ? '#ef4444' : '#f59e0b'};">${r.severity.toUpperCase()} HAZARD</span>
            <span style="font-size:0.72rem; color:var(--text-dim);">${r.time}</span>
          </div>
          <h4 style="color:#fff; font-size:0.95rem; margin:2px 0;">${r.type} – ${r.location}</h4>
          <p style="font-size:0.8rem; color:var(--text-muted); line-height:1.3;">${r.desc}</p>
          <div style="font-size:0.72rem; color:var(--text-dim); margin-top:4px;">Reported by: ${r.name}</div>
        </div>
